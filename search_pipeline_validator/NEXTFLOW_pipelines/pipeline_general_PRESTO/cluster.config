apptainer {
        enabled = true
        runOptions = '--nv -B /data/'
        envWhitelist = 'APPTAINER_BINDPATH, APPTAINER_LD_LIBRARY_PATH'
}

report.overwrite = 'true'
trace.overwrite = 'true'

process {
    executor  = 'slurm'

    errorStrategy = 'retry'
    maxRetries = 3
    maxErrors = '-1' 
        

        withLabel: 'injection' {
        cpus = 48
        memory = '360 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'rfifind' {
        cpus = 4
        memory = '32 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'presto_parfold' {
        cpus = 12
        memory = '30 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'presto_setup' {
        cpus = 1
        memory = '2 GB'
        time = '5m'
        queue = 'short.q'
        maxRetries = 3
        }

        // one job per downsample, dedispersing every DM trial in its ddplan
        withLabel: 'presto_dedisperse' {
        cpus = 10
        memory = '20 GB'
        time = { 4.hour * task.attempt }
        queue = { (task.time <= 4.hour) ? "short.q" : "long.q" }
        maxRetries = 3
        }

        // holds one segment slice per pool worker in RAM: ~cpus x segment size
        withLabel: 'presto_fft' {
        cpus = 10
        memory = '40 GB'
        time = { 2.hour * task.attempt }
        queue = { (task.time <= 4.hour) ? "short.q" : "long.q" }
        maxRetries = 3
        }

        withLabel: 'presto_accelsearch' {
        cpus = 10
        memory = '20 GB'
        time = { 2.hour * task.attempt }
        queue = { (task.time <= 4.hour) ? "short.q" : "long.q" }
        maxRetries = 3
        }

        withLabel: 'presto_cleanup' {
        cpus = 1
        memory = '2 GB'
        time = '10m'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'presto_sift' {
        cpus = 1
        memory = '7 GB'
        time = '1h'
        queue = 'short.q'
        maxRetries = 13
        }

        withLabel: 'match_candidates' {
        cpus = 1
        memory = '10 GB'
        time = '10m'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'presto_candfold' {
        cpus = 12
        memory = '90 GB'
        time = '4h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'collector' {
        cpus = 1
        memory = '4 GB'
        time = '5m'
        queue = 'short.q'
        maxRetries = 3
        }


}