apptainer {
        enabled = true
        runOptions = '-B /data/'
        envWhitelist = 'APPTAINER_BINDPATH, APPTAINER_LD_LIBRARY_PATH'
}

report.overwrite = 'true'
trace.overwrite = 'true'

process {
    executor  = 'slurm'

        withLabel: 'injection' {
        cpus = 48
        memory = '360 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'pulsarx_parfold' {
        cpus = 2
        memory = '30 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'presto_parfold' {
        cpus = 2
        memory = '30 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 1
        }

        withLabel: 'dspsr_parfold' {
        cpus = 2
        memory = '30 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 1
        }
       
}