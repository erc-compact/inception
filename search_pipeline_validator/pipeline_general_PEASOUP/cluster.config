apptainer {
        enabled = true
        runOptions = '--nv -B /data/'
        envWhitelist = 'APPTAINER_BINDPATH, APPTAINER_LD_LIBRARY_PATH'
}

report.overwrite = 'true'
trace.overwrite = 'true'

process {
    executor  = 'slurm'

        withLabel: 'injection' {
        cpus = 48
        memory = '360 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'pulsarx_parfold' {
        cpus = 10
        memory = '48 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'pulsarx_candfold' {
        cpus = 2
        memory = '48 GB'
        time = '2h'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'peasoup_setup' {
        cpus = 1
        memory = '2 GB'
        time = '5m'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'peasoup_search' {
        cpus = 1
        memory = { 36.GB * task.attempt }
        time = { 20.min * task.attempt }
        queue = { (task.time <= 4.hour) ? "short.q" : "gpu.q" }
        clusterOptions = '--gres=gpu:1'
        maxRetries = 3
        }

        withLabel: 'match_candidates' {
        cpus = 1
        memory = '10 GB'
        time = '10m'
        queue = 'short.q'
        maxRetries = 3
        }

        withLabel: 'collector' {
        cpus = 1
        memory = '4 GB'
        time = '5m'
        queue = 'short.q'
        maxRetries = 3
        }


        withLabel: 'classifier' {
        cpus = 1
        memory = '4 GB'
        time = '5m'
        queue = 'short.q'
        maxRetries = 1
        }
        

}